<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MiniPaint.App.ViewModels"
        xmlns:views="using:MiniPaint.App.Views"
        x:Class="MiniPaint.App.Views.JpegOptionsWindow"
        x:DataType="vm:JpegOptionsViewModel"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#2D2D30"
        Foreground="#DDDDDD"
        Title="{Binding Title}">

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button Content="OK" Width="88" IsDefault="True" Click="OnOkClick" />
      <Button Content="Cancel" Width="88" IsCancel="True" Click="OnCancelClick" />
    </StackPanel>

    <StackPanel Spacing="12">
      <views:JpegQualityPanel />
      <TextBlock Text="JPG has no transparency: transparent areas are filled with white."
                 TextWrapping="Wrap" Foreground="#888" FontSize="11" />
    </StackPanel>
  </DockPanel>
</Window>
