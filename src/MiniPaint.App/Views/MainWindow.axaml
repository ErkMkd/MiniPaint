<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MiniPaint.App.ViewModels"
        xmlns:ctrl="using:MiniPaint.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="MiniPaint.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="MiniPaint"
        Width="1280" Height="800"
        Background="#1E1E1E"
        Foreground="#DDDDDD"
        KeyDown="OnWindowKeyDown">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <DockPanel>
    <!-- Menu -->
    <Menu DockPanel.Dock="Top" Background="#2D2D30" Foreground="#DDD">
      <MenuItem Header="_File">
        <MenuItem Header="_New" Command="{Binding NewDocumentCommand}" InputGesture="Ctrl+N" />
        <MenuItem Header="_Open..." Command="{Binding OpenCommand}" InputGesture="Ctrl+O" />
        <Separator />
        <MenuItem Header="_Save Project..." Command="{Binding SaveProjectCommand}" InputGesture="Ctrl+S" />
        <MenuItem Header="_Export PNG..." Command="{Binding ExportPngCommand}" InputGesture="Ctrl+Shift+E" />
        <MenuItem Header="Export IFF-_ILBM..." Command="{Binding ExportIlbmCommand}" />
        <Separator />
        <MenuItem Header="_Close" Command="{Binding CloseDocumentCommand}" InputGesture="Ctrl+W" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z" />
        <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGesture="Ctrl+Y" />
        <Separator />
        <MenuItem Header="Cu_t" Command="{Binding CutCommand}" InputGesture="Ctrl+X" />
        <MenuItem Header="_Copy" Command="{Binding CopyCommand}" InputGesture="Ctrl+C" />
        <MenuItem Header="_Paste" Command="{Binding PasteCommand}" InputGesture="Ctrl+V" />
        <Separator />
        <MenuItem Header="Select _All" Command="{Binding SelectAllCommand}" InputGesture="Ctrl+A" />
        <MenuItem Header="_Deselect" Command="{Binding DeselectCommand}" InputGesture="Ctrl+D" />
        <MenuItem Header="_Transform Selection" Command="{Binding SetToolSelectionEditCommand}" InputGesture="Ctrl+Alt+T" />
        <Separator />
        <MenuItem Header="_Free Transform" Command="{Binding ToggleFreeTransformCommand}" InputGesture="Ctrl+T" />
        <MenuItem Header="_Apply Transform" Command="{Binding CommitTransformCommand}" InputGesture="Enter" />
        <MenuItem Header="Cancel Transform" Command="{Binding CancelTransformCommand}" InputGesture="Escape" />
      </MenuItem>
      <MenuItem Header="_Image">
        <MenuItem Header="_Mode..." Command="{Binding ImageModeCommand}" InputGesture="Ctrl+Shift+M" />
        <MenuItem Header="_Palette..." Command="{Binding EditPaletteCommand}" InputGesture="Ctrl+Shift+P" />
        <MenuItem Header="_Image Size..." Command="{Binding ImageSizeCommand}" InputGesture="Ctrl+Alt+I" />
        <MenuItem Header="_Canvas Size..." Command="{Binding CanvasSizeCommand}" InputGesture="Ctrl+Alt+C" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Fit to Window" Command="{Binding FitToWindowCommand}" InputGesture="Ctrl+0" />
        <MenuItem Header="_Actual Pixels (100%)" Command="{Binding Zoom100Command}" InputGesture="Ctrl+1" />
      </MenuItem>
      <MenuItem Header="_Layer">
        <MenuItem Header="_Add" Command="{Binding AddLayerCommand}" />
        <MenuItem Header="_Duplicate" Command="{Binding DuplicateLayerCommand}" />
        <MenuItem Header="_Delete" Command="{Binding DeleteLayerCommand}" />
        <Separator />
        <MenuItem Header="Move _Up" Command="{Binding MoveLayerUpCommand}" />
        <MenuItem Header="Move Do_wn" Command="{Binding MoveLayerDownCommand}" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About MiniPaint..." Command="{Binding AboutCommand}" />
        <MenuItem Header="Open _Log Folder" Command="{Binding OpenLogFolderCommand}" />
      </MenuItem>
    </Menu>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="#007ACC" Padding="8,4">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding SizeText}" Margin="16,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding CursorText}" Margin="16,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" Text="{Binding ZoomText}" Margin="16,0,0,0" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Document tabs -->
    <TabControl DockPanel.Dock="Top" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                Background="#252526" MinHeight="32">
      <TabControl.ItemTemplate>
        <DataTemplate x:DataType="vm:DocumentTabViewModel">
          <TextBlock Text="{Binding Title}" Margin="4,0" />
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate>
          <Panel />
        </DataTemplate>
      </TabControl.ContentTemplate>
    </TabControl>

    <!-- Main body -->
    <Grid ColumnDefinitions="72,*,260">
      <!-- Toolbox -->
      <Border Grid.Column="0" Background="#333337" BorderBrush="#3F3F46" BorderThickness="0,0,1,0">
        <StackPanel Margin="4" Spacing="4">
          <Button ToolTip.Tip="Rectangular Selection (V) — drag inside moves selection; Ctrl+D to clear before new marquee"
                  Command="{Binding SetToolSelectCommand}"
                  Background="{Binding CurrentTool, Converter={x:Static ctrl:ToolHighlightConverter.Instance}, ConverterParameter=RectSelect}"
                  HorizontalAlignment="Stretch" Height="44" Padding="6">
            <Image Source="/Assets/Icons/rect-select.png" Width="28" Height="28" Stretch="Uniform" />
          </Button>
          <Button ToolTip.Tip="Transform Selection (Ctrl+Alt+T) — resize selection handles"
                  Command="{Binding SetToolSelectionEditCommand}"
                  Background="{Binding CurrentTool, Converter={x:Static ctrl:ToolHighlightConverter.Instance}, ConverterParameter=SelectionEdit}"
                  HorizontalAlignment="Stretch" Height="44" Padding="6">
            <Image Source="/Assets/Icons/selection-edit.png" Width="28" Height="28" Stretch="Uniform" />
          </Button>
          <Button ToolTip.Tip="Move (M) — moves selection pixels when a selection exists; otherwise moves the layer"
                  Command="{Binding SetToolMoveCommand}"
                  Background="{Binding CurrentTool, Converter={x:Static ctrl:ToolHighlightConverter.Instance}, ConverterParameter=MoveLayer}"
                  HorizontalAlignment="Stretch" Height="44" Padding="6">
            <Image Source="/Assets/Icons/move.png" Width="28" Height="28" Stretch="Uniform" />
          </Button>
          <Button ToolTip.Tip="Pan (H / Space+drag)"
                  Command="{Binding SetToolPanCommand}"
                  Background="{Binding CurrentTool, Converter={x:Static ctrl:ToolHighlightConverter.Instance}, ConverterParameter=Pan}"
                  HorizontalAlignment="Stretch" Height="44" Padding="6">
            <Image Source="/Assets/Icons/pan.png" Width="28" Height="28" Stretch="Uniform" />
          </Button>
          <Button ToolTip.Tip="Free Transform (Ctrl+T)"
                  Command="{Binding ToggleFreeTransformCommand}"
                  Background="{Binding CurrentTool, Converter={x:Static ctrl:ToolHighlightConverter.Instance}, ConverterParameter=FreeTransform}"
                  HorizontalAlignment="Stretch" Height="44" Padding="6">
            <Image Source="/Assets/Icons/free-transform.png" Width="28" Height="28" Stretch="Uniform" />
          </Button>
          <Separator Margin="0,8" />
          <Button ToolTip.Tip="Fit" Command="{Binding FitToWindowCommand}"
                  HorizontalAlignment="Stretch" Height="40" Padding="6">
            <Image Source="/Assets/Icons/fit.png" Width="24" Height="24" Stretch="Uniform" />
          </Button>
          <Button ToolTip.Tip="100%" Command="{Binding Zoom100Command}"
                  HorizontalAlignment="Stretch" Height="40" Padding="6">
            <Image Source="/Assets/Icons/zoom-100.png" Width="24" Height="24" Stretch="Uniform" />
          </Button>
        </StackPanel>
      </Border>

      <!-- Canvas + transform options bar -->
      <DockPanel Grid.Column="1">
        <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="8,4"
                IsVisible="{Binding IsTransforming}">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Text="{Binding TransformInfo}" VerticalAlignment="Center"
                       FontSize="12" Foreground="#EEE" TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="Opacity" VerticalAlignment="Center"
                       Margin="12,0,6,0" FontSize="11" Foreground="#AAA" />
            <Slider x:Name="TransformOpacitySlider" Grid.Column="2" Width="120"
                    Minimum="0" Maximum="1"
                    TickFrequency="0.01" IsSnapToTickEnabled="False"
                    Value="{Binding TransformOpacity, Mode=TwoWay}" />
            <TextBlock Grid.Column="3" Text="{Binding TransformOpacity, StringFormat={}{0:P0}}"
                       VerticalAlignment="Center" Margin="6,0,8,0" FontSize="11" Foreground="#CCC"
                       MinWidth="36" />
            <ComboBox Grid.Column="4" Width="140" Margin="0,0,8,0"
                      ItemsSource="{Binding BlendModes}"
                      SelectedItem="{Binding SelectedBlendOption}"
                      SelectionChanged="OnBlendSelectionChanged" />
            <Button Grid.Column="5" Content="Apply" Margin="4,0" Padding="10,2"
                    Command="{Binding CommitTransformCommand}" />
            <Button Grid.Column="6" Content="Cancel" Padding="10,2"
                    Command="{Binding CancelTransformCommand}" />
          </Grid>
        </Border>
        <Border DockPanel.Dock="Top" Background="#1E3A5F" Padding="8,4"
                IsVisible="{Binding IsEditingSelection}">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Text="{Binding SelectionEditInfo}" VerticalAlignment="Center"
                       FontSize="12" Foreground="#EEE" TextWrapping="NoWrap" />
            <Button Grid.Column="1" Content="Apply" Margin="8,0" Padding="10,2"
                    Command="{Binding CommitSelectionEditCommand}" />
            <Button Grid.Column="2" Content="Cancel" Padding="10,2"
                    Command="{Binding CancelSelectionEditCommand}" />
          </Grid>
        </Border>
        <Border Background="#1E1E1E">
          <ctrl:ImageCanvas x:Name="Canvas"
                            Workspace="{Binding ActiveWorkspace}"
                            Tool="{Binding CurrentTool}" />
        </Border>
      </DockPanel>

      <!-- Layers panel -->
      <Border Grid.Column="2" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1,0,0,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Layers" FontWeight="SemiBold"
                     Margin="10,8,10,4" Foreground="#CCC" />
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,8,8" Spacing="4">
            <Button Content="+" ToolTip.Tip="Add" Command="{Binding AddLayerCommand}" Width="28" />
            <Button Content="⧉" ToolTip.Tip="Duplicate" Command="{Binding DuplicateLayerCommand}" Width="28" />
            <Button Content="✕" ToolTip.Tip="Delete" Command="{Binding DeleteLayerCommand}" Width="28" />
            <Button Content="↑" ToolTip.Tip="Up" Command="{Binding MoveLayerUpCommand}" Width="28" />
            <Button Content="↓" ToolTip.Tip="Down" Command="{Binding MoveLayerDownCommand}" Width="28" />
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Margin="8" Spacing="4">
            <TextBlock Text="Blend mode" FontSize="11" Foreground="#AAA" />
            <ComboBox HorizontalAlignment="Stretch"
                      ItemsSource="{Binding BlendModes}"
                      SelectedItem="{Binding SelectedBlendOption}"
                      SelectionChanged="OnBlendSelectionChanged" />
            <TextBlock Text="Opacity" FontSize="11" Foreground="#AAA" Margin="0,6,0,0" />
            <Slider x:Name="LayerOpacitySlider"
                    Minimum="0" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="False"
                    Value="{Binding SelectedLayer.Opacity, Mode=TwoWay}" />
            <TextBox PlaceholderText="Rename layer..." x:Name="RenameBox"
                     KeyDown="OnRenameKeyDown" />
          </StackPanel>

          <ListBox x:Name="LayersList"
                   ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}"
                   Background="Transparent" Margin="4"
                   ContextRequested="OnLayersContextRequested">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="New Image from Layer Content"
                          Command="{Binding CreateImageFromLayerCommand}"
                          CommandParameter="{Binding SelectedLayer}" />
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LayerItemViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="2">
                  <CheckBox IsChecked="{Binding IsVisible}"
                            Click="OnVisibilityClick"
                            Tag="{Binding}" />
                  <StackPanel Grid.Column="1" Margin="6,0" Spacing="0">
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BlendModeLabel}" Foreground="#777" FontSize="10" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Opacity, StringFormat={}{0:P0}}"
                             Foreground="#888" FontSize="11" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
